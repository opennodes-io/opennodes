// Cloudflare Workers config: serves the opennodes.io landing page (site/) as static assets.
// Deployed by Cloudflare Workers Builds on every push to main (`npx wrangler deploy`).
{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "opennodes",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
