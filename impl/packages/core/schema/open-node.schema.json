{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opennodes.io/schemas/0.1/open-node.schema.json",
  "title": "OpenNodes Node Card",
  "description": "Normative structure of an ONP Node Card (ONP-2). The prose in ONP-2 is normative for semantics. Vocabulary fields are open: core values are listed in each description; unknown values follow the must-ignore rules of ONP-1 §5.",
  "type": "object",
  "required": ["onp", "revision", "node", "endpoints", "offerings", "payment"],
  "additionalProperties": true,
  "properties": {
    "onp": { "type": "string", "pattern": "^0\\.[0-9]+$", "description": "ONP version the card was written against. Any 0.x is accepted within the 0 major version (ONP-1 §5)." },
    "revision": { "type": "string", "format": "date-time" },
    "node": {
      "type": "object",
      "required": ["id", "name", "operator"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "operator": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "contact": { "type": "string" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
          }
        },
        "did": { "type": "string", "pattern": "^did:[a-z0-9]+:.+$" },
        "regions": { "$ref": "#/$defs/regions" }
      }
    },
    "endpoints": {
      "type": "object",
      "required": ["openai", "health"],
      "properties": {
        "openai": { "type": "string", "format": "uri" },
        "health": { "type": "string", "format": "uri" },
        "receipts": { "type": ["string", "null"], "format": "uri" },
        "a2a": { "type": ["string", "null"], "format": "uri" },
        "docs": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "offerings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/offering" }
    },
    "hardware": { "$ref": "#/$defs/hardware" },
    "payment": {
      "type": "object",
      "required": ["schemes"],
      "properties": {
        "schemes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scheme"],
            "properties": {
              "scheme": { "$ref": "#/$defs/scheme" },
              "networks": { "type": "array", "items": { "type": "string" } },
              "asset": { "type": "string" },
              "signup": { "type": "string", "format": "uri" },
              "settlement_registry": { "type": "string", "format": "uri" }
            }
          }
        },
        "probe_allowance": {
          "type": "object",
          "properties": { "requests_per_day": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "certifications": { "type": "array", "items": { "type": "string" } },
        "gdpr": { "type": "boolean" },
        "attestations": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["protected", "signature"],
        "properties": {
          "protected": { "type": "string" },
          "signature": { "type": "string" },
          "kid": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "basis": { "enum": ["claimed", "attested"] },
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "scheme": {
      "$ref": "#/$defs/token",
      "description": "Payment scheme. Core values: x402, prepaid, free (ONP-5 §2). Profiles may register more; a client that does not know a scheme cannot pay with it and treats it as absent."
    },
    "regions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Region codes. SHOULD be ISO 3166-1 alpha-2 (\"CA\"), ISO 3166-2 (\"CA-QC\") or the reserved code \"EU\"; matching is case-insensitive and a code contains its own subdivisions (\"CA\" contains \"CA-QC\"). See ONP-2 §3."
    },
    "hardware": {
      "type": "object",
      "properties": {
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "count"],
            "properties": {
              "type": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "memory_gb": { "type": "number", "minimum": 0 }
            }
          }
        },
        "basis": { "$ref": "#/$defs/basis" },
        "mlperf": {
          "type": "object",
          "properties": {
            "suite": { "type": "string" },
            "system_id": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "measured": {
      "type": "object",
      "required": ["basis"],
      "properties": {
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "basis": { "$ref": "#/$defs/basis" },
        "attestation": { "type": "string", "format": "uri" }
      }
    },
    "offering": {
      "type": "object",
      "required": ["offering_id", "modality", "model", "serving", "binding", "pricing"],
      "properties": {
        "offering_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
        "modality": {
          "$ref": "#/$defs/token",
          "description": "Core values: text, image, audio, video, embedding, multimodal, agent, tools (ONP-2 §5). A client skips offerings whose modality it does not know."
        },
        "model": {
          "type": "object",
          "required": ["name", "artifact"],
          "properties": {
            "name": { "type": "string" },
            "family": { "type": "string" },
            "artifact": { "type": "string", "pattern": "^(hf:[^/\\s]+/[^/\\s]+|urn:proprietary:[a-z0-9-]+:[A-Za-z0-9._-]+)$" },
            "params_b": { "type": "number", "minimum": 0 },
            "quantization": { "type": "string" },
            "license": { "type": "string" },
            "revision_pin": { "type": "string" }
          }
        },
        "serving": {
          "type": "object",
          "properties": {
            "context_window": { "type": "integer", "minimum": 1 },
            "max_output_tokens": { "type": "integer", "minimum": 1 },
            "supports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/token",
                "description": "Core values: streaming, tool_calls, parallel_tool_calls, json_mode, structured_outputs, vision, audio_input, edit, reasoning, logprobs, prompt_caching (ONP-2 §5). Unknown values are ignored (the capability is treated as absent)."
              }
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["lang", "grade"],
                "properties": {
                  "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 language tag, e.g. en, fr, fr-CA." },
                  "grade": { "enum": ["native", "strong", "basic"] },
                  "basis": { "$ref": "#/$defs/basis" },
                  "attestation": { "type": "string", "format": "uri" }
                }
              }
            },
            "expected_ttft_ms": { "$ref": "#/$defs/measured" },
            "expected_tps": { "$ref": "#/$defs/measured", "description": "Per-stream decode rate in output tokens per second, as one client observes it. Aggregate node throughput belongs in capacity.aggregate_output_tps." }
          }
        },
        "capacity": {
          "type": "object",
          "description": "Throughput the offering can sustain as a whole, and the limits it enforces (ONP-2 §5).",
          "properties": {
            "aggregate_output_tps": { "$ref": "#/$defs/measured" },
            "max_concurrency": { "type": "integer", "minimum": 1 },
            "rate_limits": {
              "type": "object",
              "properties": {
                "rpm": { "type": "integer", "minimum": 0 },
                "input_tpm": { "type": "integer", "minimum": 0 },
                "output_tpm": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "hardware": { "$ref": "#/$defs/hardware" },
        "binding": {
          "type": "object",
          "required": ["profile", "model_id"],
          "properties": {
            "profile": { "type": "string", "pattern": "^[a-z0-9.-]+/v[0-9]+$" },
            "model_id": { "type": "string" }
          }
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["suite", "score", "basis"],
            "properties": {
              "suite": { "type": "string" },
              "score": { "type": "number" },
              "basis": { "$ref": "#/$defs/basis" },
              "attestation": { "type": "string", "format": "uri" }
            }
          }
        },
        "pricing": {
          "type": "object",
          "required": ["currency", "schemes"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "input_per_mtok": { "type": "number", "minimum": 0 },
            "output_per_mtok": { "type": "number", "minimum": 0 },
            "cached_input_per_mtok": { "type": "number", "minimum": 0 },
            "per_image": { "type": ["number", "object"] },
            "per_second": { "type": "number", "minimum": 0 },
            "per_mchar": { "type": "number", "minimum": 0 },
            "per_minute": { "type": "number", "minimum": 0 },
            "per_task": { "type": "number", "minimum": 0 },
            "per_call": { "type": "number", "minimum": 0 },
            "schemes": {
              "type": "array",
              "minItems": 1,
              "description": "Schemes accepted for this offering; MUST be a subset of the node-level payment.schemes (ONP-5 §2).",
              "items": { "$ref": "#/$defs/scheme" }
            },
            "free_tier": {
              "type": "object",
              "properties": { "requests_per_day": { "type": "integer", "minimum": 0 } }
            }
          }
        },
        "availability": {
          "type": "object",
          "properties": {
            "sla": { "type": "number", "minimum": 0, "maximum": 1 },
            "interruptible": { "type": "boolean" }
          }
        },
        "data_policy": {
          "type": "object",
          "properties": {
            "retention": {
              "$ref": "#/$defs/token",
              "description": "Core values: none, ephemeral, logged (ONP-2 §5). Clients treat an unknown value as logged."
            },
            "retention_max_seconds": { "type": "integer", "minimum": 0, "description": "Upper bound on how long request or response content may exist at the node. REQUIRED when retention is ephemeral." },
            "training_on_inputs": { "type": "boolean" },
            "region_pinning": { "$ref": "#/$defs/regions" }
          },
          "allOf": [
            { "if": { "properties": { "retention": { "const": "ephemeral" } }, "required": ["retention"] },
              "then": { "required": ["retention_max_seconds"] } }
          ]
        }
      }
    }
  }
}
