{
  "name": "@opennodes/cli",
  "version": "0.1.0",
  "description": "OpenNodes (ONP) client: search verified AI nodes, pre-price chains, invoke with signed receipts; OpenAI-compatible gateway with onp/auto routing; stdio MCP server for Cursor, VS Code, and Claude Desktop",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/client.js",
  "exports": { ".": "./src/client.js", "./src/*": "./src/*" },
