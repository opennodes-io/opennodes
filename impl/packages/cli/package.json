  "files": ["bin.js", "src", "README.md", "server.json"],
  "mcpName": "io.github.opennodes-io/opennodes",
  "keywords": ["opennodes", "onp", "mcp", "mcp-server", "ai", "inference", "router", "gateway", "openai-compatible", "cursor", "claude-desktop"],
  "homepage": "https://opennodes.io",
  "repository": { "type": "git", "url": "git+https://github.com/opennodes-io/opennodes.git", "directory": "impl/packages/cli" },
  "bugs": { "url": "https://github.com/opennodes-io/opennodes/issues" },
  "engines": { "node": ">=22.5" },
  "publishConfig": { "access": "public" },
  "dependencies": { "@opennodes/core": "0.1.0" }
