# Copy to .env and adjust. The node id must match the host: io.opennodes.helsinki <-> helsinki.opennodes.io
NODE_ID=io.opennodes.helsinki
NODE_HOST=helsinki.opennodes.io
MODEL=gemma3:1b
NODE_NAME=OpenNodes reference node (Helsinki)
OPERATOR=OpenNodes Project
COUNTRY=FI
DESCRIPTION=Reference node run by the OpenNodes project: Gemma 3 1B on a 2 vCPU CPU-only VM (Hetzner CPX22, Helsinki). Free and honest - a second key-less node in a different country and model family from the demo node.
# setup.sh fills these from the machine when left empty
HW_TYPE=
HW_COUNT=
